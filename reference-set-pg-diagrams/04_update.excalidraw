    {
      "id": "vgCiUV9xfP1qEzTFNT1ZS",
      "type": "text",
      "x": 40,
      "y": 532.9,
      "width": 180,
      "height": 96.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a00078",
      "roundness": null,
      "seed": 334999224,
      "version": 1,
      "versionNonce": 902088293,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779661677,
      "link": null,
      "locked": false,
      "text": "The old tuple is now dead.\nOnce no snapshot can still\nsee it, VACUUM (later, in\nthe background) reclaims the\nspace. This is why UPDATE-\nheavy tables bloat without\nautovacuum tuning.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The old tuple is now dead.\nOnce no snapshot can still\nsee it, VACUUM (later, in\nthe background) reclaims the\nspace. This is why UPDATE-\nheavy tables bloat without\nautovacuum tuning.",
      "autoResize": false,
      "lineHeight": 1.25
    },
