    {
      "id": "4cFdli0PgzpVEU5COXguk",
      "type": "text",
      "x": 40,
      "y": 326.9,
      "width": 180,
      "height": 110.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a00075",
      "roundness": null,
      "seed": 793940517,
      "version": 1,
      "versionNonce": 638547992,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779661677,
      "link": null,
      "locked": false,
      "text": "An UPDATE never overwrites a\ntuple. It ADDS a new version\nand marks the old one as no\nlonger visible after XID\n103.\nConcurrent readers keep\nseeing the old version until\ntheir snapshot expires.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An UPDATE never overwrites a\ntuple. It ADDS a new version\nand marks the old one as no\nlonger visible after XID\n103.\nConcurrent readers keep\nseeing the old version until\ntheir snapshot expires.",
      "autoResize": false,
      "lineHeight": 1.25
    },
