    {
      "id": "HRtyX8oT7obMHqp2fBzIZ",
      "type": "text",
      "x": 40,
      "y": 539.8,
      "width": 180,
      "height": 110.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a00076",
      "roundness": null,
      "seed": 820148172,
      "version": 1,
      "versionNonce": 232213887,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779659728,
      "link": null,
      "locked": false,
      "text": "COMMIT is durable once the\nWAL record is fsync'd, even\nthough the heap page is\nstill\nonly DIRTY in memory. That\nis\nwhy commits are fast and the\npage flush can happen later.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "COMMIT is durable once the\nWAL record is fsync'd, even\nthough the heap page is\nstill\nonly DIRTY in memory. That\nis\nwhy commits are fast and the\npage flush can happen later.",
      "autoResize": false,
      "lineHeight": 1.25
    },
