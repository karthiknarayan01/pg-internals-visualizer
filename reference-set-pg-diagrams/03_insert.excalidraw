      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a00072",
      "roundness": null,
      "seed": 398512730,
      "version": 1,
      "versionNonce": 861437238,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779659728,
      "link": null,
      "locked": false,
      "text": "INSERT takes a RowExclusive-\nLock on tbl_a - weaker than\nit sounds: many inserts run\nconcurrently. It only blocks\nDDL and explicit table\nlocks.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "INSERT takes a RowExclusive-\nLock on tbl_a - weaker than\nit sounds: many inserts run\nconcurrently. It only blocks\nDDL and explicit table\nlocks.",
      "autoResize": false,
      "lineHeight": 1.25
    },
