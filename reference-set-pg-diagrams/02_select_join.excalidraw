      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779657732,
      "link": null,
      "locked": false,
      "text": "The planner may swap which\nside is 'build' vs 'probe'\nand may choose Nested Loop\nor Merge Join instead of\nHash, based on row-count\nand\ncost estimates from\nANALYZE\nstatistics.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
