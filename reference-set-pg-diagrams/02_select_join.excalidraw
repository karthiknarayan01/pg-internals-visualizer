      "text": "One AccessShareLock per\ntable (orders, customers,\nitems), each held for the\nwhole txn. Readers never\nblock other\nreaders/writers.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One AccessShareLock per\ntable (orders, customers,\nitems), each held for the\nwhole txn. Readers never\nblock other\nreaders/writers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
