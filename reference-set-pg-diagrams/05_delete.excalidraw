      "boundElements": null,
      "updated": 1784779663558,
      "link": null,
      "locked": false,
      "text": "Autovacuum periodically\nscans\nfor dead tuples whose xmax\nis older than the oldest\nlive\nsnapshot, then reclaims\ntheir\nspace (and prunes matching\nindex entries).",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Autovacuum periodically\nscans\nfor dead tuples whose xmax\nis older than the oldest\nlive\nsnapshot, then reclaims\ntheir\nspace (and prunes matching\nindex entries).",
      "autoResize": false,
      "lineHeight": 1.25
    },
