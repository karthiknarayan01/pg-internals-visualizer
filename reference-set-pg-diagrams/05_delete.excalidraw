      "index": "a00072",
      "roundness": null,
      "seed": 294978796,
      "version": 1,
      "versionNonce": 659719741,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779663558,
      "link": null,
      "locked": false,
      "text": "Same shape, minus the NEW\ntuple insert. UPDATE = xmax\nold + insert new. DELETE =\nxmax only. Both are logical\ndeletes: no bytes\noverwritten,\nspace reclaimed by VACUUM.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same shape, minus the NEW\ntuple insert. UPDATE = xmax\nold + insert new. DELETE =\nxmax only. Both are logical\ndeletes: no bytes\noverwritten,\nspace reclaimed by VACUUM.",
      "autoResize": false,
      "lineHeight": 1.25
    },
