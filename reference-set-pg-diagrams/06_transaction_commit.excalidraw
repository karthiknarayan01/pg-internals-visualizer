      "link": null,
      "locked": false,
      "text": "A concurrent reader's snapshot taken BEFORE t5 still sees\nthe OLD tuple version; one taken AFTER sees the new one.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A concurrent reader's snapshot taken BEFORE t5 still sees\nthe OLD tuple version; one taken AFTER sees the new one.",
      "autoResize": false,
      "lineHeight": 1.25
    },
