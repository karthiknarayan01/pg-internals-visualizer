    },
    {
      "id": "kWo13PPdEa9Uhf31qyBEa",
      "type": "text",
      "x": 40,
      "y": 498.9,
      "width": 165,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a00084",
      "roundness": null,
      "seed": 207059710,
      "version": 1,
      "versionNonce": 196053721,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779655554,
      "link": null,
      "locked": false,
      "text": "A read-only SELECT burns\nno real XID. Postgres\nassigns a Virtual\nTransactionId (PID +\ncounter) for locks and\nsnapshot bookkeeping.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A read-only SELECT burns\nno real XID. Postgres\nassigns a Virtual\nTransactionId (PID +\ncounter) for locks and\nsnapshot bookkeeping.",
      "autoResize": false,
      "lineHeight": 1.25
    },
