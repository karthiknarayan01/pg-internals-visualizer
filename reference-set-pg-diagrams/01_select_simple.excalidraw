    },
    {
      "id": "wN0Yn74skm7sUCQWA1A4z",
      "type": "text",
      "x": 40,
      "y": 662.9,
      "width": 165,
      "height": 96.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a00087",
      "roundness": null,
      "seed": 323338867,
      "version": 1,
      "versionNonce": 467150140,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779655554,
      "link": null,
      "locked": false,
      "text": "A PIN stops the buffer\nbeing evicted while in\nuse. A CONTENT LOCK\n(shared for reads)\nguards the bytes so a\nreader never sees a\ntuple torn mid-write.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A PIN stops the buffer\nbeing evicted while in\nuse. A CONTENT LOCK\n(shared for reads)\nguards the bytes so a\nreader never sees a\ntuple torn mid-write.",
      "autoResize": false,
      "lineHeight": 1.25
    },
