      "isDeleted": false,
      "boundElements": null,
      "updated": 1784779655554,
      "link": null,
      "locked": false,
      "text": "Backend also holds an\nAccessShareLock on\ntbl_a for the whole txn.\nBlocks only DDL\n(ALTER / DROP) - never\nother reads or writes.",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Backend also holds an\nAccessShareLock on\ntbl_a for the whole txn.\nBlocks only DDL\n(ALTER / DROP) - never\nother reads or writes.",
      "autoResize": false,
      "lineHeight": 1.25
    },
