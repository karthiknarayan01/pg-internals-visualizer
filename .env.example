# Local LLM (Ollama) — used by the orchestrator, PG internals expert, and
# visual critique agents alike (matches the personal-assistant project's
# setup; qwen2.5:32b was tried for richer writing and was too slow/heavy for
# local use, so everything runs on this same proven 14b model).
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_API_BASE=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# How many times the PG Internals Expert and Visual Critique go back and
# forth per visualization (draft -> critique -> revise, repeated). Higher
# means better-refined output but longer waits — each round is a couple of
# full LLM calls. Lowered from 3 to 1: with the Expert's first draft now
# forced through a concrete reference checklist (see PG_EXPERT_INSTRUCTION),
# most of what critique rounds used to fix should already be right on the
# first pass, so paying for 2-3 extra rounds isn't worth the latency.
MAX_CRITIQUE_ROUNDS=1

# Sandbox Postgres (docker-compose.yml)
PG_SANDBOX_HOST=localhost
PG_SANDBOX_PORT=5433
PG_SANDBOX_DB=sandbox
PG_SANDBOX_USER=sandbox
PG_SANDBOX_PASSWORD=sandbox

# Chroma persistent store
CHROMA_DB_DIR=./knowledge/chroma_db
